# Caches and build output
__pycache__/
*.py[oc]
*.egg-info
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
dist/
build/
out/
# The paper's build tooling and its committed outputs are source, not build output:
# paper/score/build/ holds the build script and its check, paper/score/out/ the PDF and the stamp
# that `make check` compares against.
!paper/score/build/
!paper/score/out/
target/
.gradle/

# OS and editor
.DS_Store
*:Zone.Identifier
.idea/
.vscode/*

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Environment
.env
.env.*
!.env.example

# Session state: per-clone, regenerable
.claude/worktrees/
.claude/state/
tmp/

# Claude's memory: private working notes, never pushed (this repository is public)
.claude/memory/
.venv
