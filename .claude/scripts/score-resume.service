# Starts again, at boot, every `score run` a reboot cut off (score/graph/runs.py: each from its own worktree).
# Written only; installing it is the owner's step, and needs systemd=true under [boot] in /etc/wsl.conf:
#   mkdir -p ~/.config/systemd/user && cp .claude/scripts/score-resume.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable score-resume.service
#   loginctl enable-linger "$USER"     # so the user's units start at boot without a login
[Unit]
Description=SCORE: resume the runs a reboot cut off
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/score
ExecStart=%h/projects/score/.venv/bin/python -m score resume

[Install]
WantedBy=default.target
