# The build of codebase-memory-mcp this harness runs, one row set per platform
# upstream ships, and the two checksums that prove a download is that build.
# `cbm_pin.py` reads this file; `install.sh` installs what it names into
# ~/.cache/harness/cbm/<version>/, never the shared ~/.local/bin, which any
# other installer on the box may overwrite.
#
# WHY PINNED. The index is what a session reads before it changes code. A
# version that moves under it changes answers nobody asked to change, and an
# index written by one build and read by another surfaces as a wrong answer
# rather than an error. Every repository on one account must also pin the SAME
# version: the binary allows one daemon version per user account, and a second
# version is refused while the first runs, even from another HOME.
#
# WHY v0.12.1. Against 0.11.0: the same tables and the same `cli --json` payload
# keys, a cold cli query in about 1 s instead of 3.2 s, and a faster index.
#
# WHY THE PORTABLE LINUX ASSETS. Upstream publishes two linux builds per CPU;
# portable is the one upstream's own installer picks and the one that asks
# nothing of the host's glibc. macOS has one build.
#
# WHY TWO CHECKSUMS. CBM_TARBALL_SHA256 is upstream's own published figure, the
# row for this asset in the release's checksums.txt. CBM_SHA256 is the EXTRACTED
# binary, the artefact that actually runs; a tarball check alone would not
# notice a swap inside the archive. Both are re-checked on every install, so a
# swapped asset fails the install rather than the first question asked of it.
CBM_VERSION=v0.12.1
CBM_UPSTREAM=DeusData/codebase-memory-mcp

# Keys are `uname -s`_<cpu>, lowercased, cpu as upstream spells it (cbm_pin.py
# maps x86_64 to amd64 and aarch64 to arm64).
CBM_ASSET_linux_amd64=codebase-memory-mcp-linux-amd64-portable.tar.gz
CBM_TARBALL_SHA256_linux_amd64=8c3d0341064301e78ecc84cf7348d4e2c6562a0f57448243ea560aaa34de36c1
CBM_SHA256_linux_amd64=77745491f0a9c346d6da23eed4d92b5feaa31a27a883c9faa4fa9f47c8183705

CBM_ASSET_linux_arm64=codebase-memory-mcp-linux-arm64-portable.tar.gz
CBM_TARBALL_SHA256_linux_arm64=ed0f1f548cd79b121c401c2e9f7841c189a001af26d3768368088c24f6a53533
CBM_SHA256_linux_arm64=6a64e20e2ca8dc15b4a412e981e5aea60804ed3e952d693ab491c93ccd36ed45

CBM_ASSET_darwin_amd64=codebase-memory-mcp-darwin-amd64.tar.gz
CBM_TARBALL_SHA256_darwin_amd64=ca6e64397a8ae80cec898a8205a6aa16750ac798acc05a0c3ed983837944a581
CBM_SHA256_darwin_amd64=f3ba4d7dd462be868eff85f0dccb7375405f58084da800826065df2312b028ab

CBM_ASSET_darwin_arm64=codebase-memory-mcp-darwin-arm64.tar.gz
CBM_TARBALL_SHA256_darwin_arm64=9bfcbe38414b47969a3e1d1c1999f5357409387c86fa3d24221b5458267660d2
