#!/usr/bin/env bash
# The git pre-push hook, found here because core.hooksPath points at
# .claude/hooks. Its one check of its own is the push cap (push_cap.py beside
# it: a push to main past the day's limit in the machine's cap config is
# refused, counted over every repository sharing that config). Then it hands
# git's arguments and the push lines on stdin to .claude/hooks/local/pre-push
# when this checkout has one, and lets the push go when it does not; a push
# that hook refuses gives its cap slot back. A local pre-push may be kept out
# of the repository (git-ignored), so each person can carry their own guard.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
here=$(cd "$(dirname "$0")" && pwd)
lines=$(cat)
cap="$here/push_cap.py"
if [ -f "$cap" ]; then
    printf '%s\n' "$lines" | python3 "$cap" claim || exit 1
fi
local_hook="$root/.claude/hooks/local/pre-push"
rc=0
if [ -x "$local_hook" ]; then
    printf '%s\n' "$lines" | "$local_hook" "$@"
    rc=$?
elif [ -e "$local_hook" ]; then
    echo "note: $local_hook is not executable, so it did not run" >&2
fi
if [ "$rc" -ne 0 ] && [ -f "$cap" ]; then
    printf '%s\n' "$lines" | python3 "$cap" release
fi
exit "$rc"
