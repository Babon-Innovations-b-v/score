#!/usr/bin/env bash
# Refuse a push to main whose commit moves a paid row's key against main's (score moved --pre-push: code, stage table
# part or a declared file, every world, about a minute), unless a pushed commit's "Moved-rows: <row or node> ...:
# <reason>" trailer names it. Which rows a run would buy again is asked before a run starts, not here. Git runs .claude/hooks/pre-push, which hands
# the push to .claude/hooks/local/pre-push (the push gate), which hands its stdin on to this script once its own checks
# pass. It runs while
#   git config score.movedCheck true        (score.movedTimeout: seconds before it gives up, default 3600)
# is set.
# Deletions, tags and other branches pass at once. The check runs on the commit pushed to main: in this checkout when
# it is that commit with nothing changed, else in a temporary worktree of it, removed afterwards (when none can be
# made the push is refused and nothing is left behind). A commit made before score moved existed is not checked.
# The places and accepted rows are read from a home with a store: PROPS_HOME when set, else `git config score.movedHome`,
# else the default home (~/.farm-factory-props) when it holds a store, else this PC's run home (tools/cloud/this_pc.py's,
# SCORE_THIS_PC_HOME, default ~/.score-this-pc: its pull of the conductor's store). With none the push goes on, said.
# It also prints how many accepted rows the push makes again, free ones too ("this push re-makes N accepted rows (P
# paid, EUR X)"), and while a push freeze stands (remake_freeze.py beside it: a file outside the repository) refuses
# a push that makes accepted rows again unless a pushed commit's "Remakes: <row or node> ...: <reason>" trailer names
# them. #107 is the root fix (a key moves only when the row's output would).
# git's push lines come on stdin and pass straight through.
set -euo pipefail
[ "$(git config --bool score.movedCheck || true)" = true ] || exit 0
lines="$(cat)"
tip=""
while read -r _ local_sha remote_ref _; do
  if [ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != 0000000000000000000000000000000000000000 ]; then
    tip="$local_sha"
  fi
done <<< "$lines"
[ -n "$tip" ] || exit 0
home="${PROPS_HOME:-$(git config score.movedHome || true)}"
if [ -z "$home" ]; then
  for candidate in "$HOME/.farm-factory-props" "${SCORE_THIS_PC_HOME:-$HOME/.score-this-pc}"; do
    if [ -d "$candidate/store/objects" ]; then home="$candidate"; break; fi
  done
fi
if [ -z "$home" ] || [ ! -d "$home/store/objects" ]; then
  echo "moved check: no home with a store here (PROPS_HOME, or git config score.movedHome), not checked"
  exit 0
fi
export PROPS_HOME="$home"
repo="$(git rev-parse --show-toplevel)"
python="$repo/.venv/bin/python"
if [ ! -x "$python" ]; then  # a worktree uses the main checkout's environment
  python="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)/.venv/bin/python"
fi
checkout="$repo"
if [ "$(git rev-parse HEAD)" != "$tip" ] || [ -n "$(git status --porcelain)" ]; then
  checkout="$(mktemp -d)"
  if ! git -C "$repo" worktree add --detach -q "$checkout" "$tip"; then
    rm -rf "$checkout"
    echo "refused: no worktree of ${tip:0:12} could be made for the moved check" >&2
    exit 1
  fi
  trap 'git -C "$repo" worktree remove --force "$checkout"' EXIT
fi
if ! grep -qs -- "--pre-push" "$checkout/score/__main__.py"; then
  echo "moved check: ${tip:0:12} predates score moved, not checked"
  exit 0
fi
limit="$(git config score.movedTimeout || echo 3600)"
remakes="$(mktemp)"
freeze="$repo/.claude/hooks/local/remake_freeze.py"
cd "$checkout"
status=0
printf '%s\n' "$lines" | SCORE_REMAKES_FILE="$remakes" timeout "$limit" "$python" -m score moved --pre-push || status=$?
if [ "$status" -eq 124 ]; then
  echo "refused: the moved check ran past $limit s (score.movedTimeout); push again, or raise it" >&2
fi
if [ "$status" -eq 0 ] && [ -s "$remakes" ]; then
  printf '%s\n' "$lines" | python3 "$freeze" "$remakes" || status=$?
fi
rm -f "$remakes"
exit "$status"
