# TEMPLATE: the sync's systemd user timer, written to ~/.config/systemd/user/score-sync.timer and enabled by
# `python -m score.dashboard install-sync` (score-sync.service.example says when and how). Its passes:
# `journalctl --user -u score-sync.service`.
[Unit]
Description=SCORE dashboard sync every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
