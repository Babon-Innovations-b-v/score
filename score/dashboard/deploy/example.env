# TEMPLATE: copy outside the repo and fill in. Never commit the real values.
SCORE_DASHBOARD_MODE=hosted
SCORE_DASHBOARD_HOME=/data
SCORE_BIND=0.0.0.0:8780
SCORE_ALLOWED_HOSTS=<dashboard.example.org>
SCORE_TRUSTED_PROXIES=<caddy address or the compose network CIDR>
SCORE_ALLOWED_USERS=<your user name>
SCORE_OWNER=<your user name>
SCORE_STORE_WRITABLE=0
SCORE_SYNC_TOKEN=<32 or more random characters>
SCORE_EXPORT_MAX_MB=300
# Store side only (the machine beside the store, for `python -m score.dashboard sync`):
SCORE_SYNC_URL=<https://dashboard.example.org>
SCORE_SYNC_MAX_EUROS=<a cap on one hosted launch's high estimate, or 0 for none>
SCORE_MONTH_EUROS=<the month's stop in euros>
SCORE_LEDGER_FILES=<colon list of JSONL ledgers with measured runs>
SCORE_BILL_FACTOR=1.21
