# TEMPLATE: the store's upkeep pass as a systemd user service on a machine beside the store. Never copied by hand:
# `python -m score.dashboard install-sync` (sync/timer.py) fills in the two <slots>, writes it to
# ~/.config/systemd/user/score-sync.service beside its timer and enables the timer. The user manager needs
# `loginctl enable-linger <you>` for the timer to run with no shell open.
#
# Before each pass the checkout is pulled to origin's main (ExecStartPre). On a conductor `install-sync --no-pull`
# puts the conductor's update (tools/cloud/conductor/update.py, the system python) in that line's place, so every pass
# starts on origin's main once it is safe to move (score-update's own timer waits while a pass runs, and a pass
# outlasts 5 minutes).
#
# The pass refuses, and says why in the journal, from a checkout with changes not committed or a commit origin's main
# does not hold, and stops when the runner's price (`score price <environment> --gaps`) fails.
[Unit]
Description=SCORE upkeep pass: the store's free steps, the runner's price and the basket

[Service]
# A run it launches outlives it: stop only this unit's own process, never the detached runs it started (2026-10-24: the
# first Buy was killed the moment its sync pass ended).
KillMode=process
Type=oneshot
WorkingDirectory=<path to the score repository>
EnvironmentFile=<path to the env file kept outside the repo>
ExecStartPre=/usr/bin/git -C <path to the score repository> pull -q --ff-only
ExecStart=<path to the score repository>/.venv/bin/python -m score.dashboard sync
