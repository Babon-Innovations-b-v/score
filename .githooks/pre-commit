#!/usr/bin/env bash
# Refuse a commit that would leave the paper's committed PDF and LaTeX older than its draft.
# Installed by .claude/scripts/bootstrap.sh (git config core.hooksPath .githooks).
set -euo pipefail
repo="$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -q '^paper/'; then
  if ! python3 "$repo/paper/build/build.py" --check; then
    echo "pre-commit: the paper build is stale. Run 'make paper', stage paper/, commit again." >&2
    exit 1
  fi
fi
