# The conductor's file-shaped secrets (score-lib-deploy-key, google-billing-reader) written to tmpfs at
# /run/user/<uid>/score, mode 600, never to disk (tools/cloud/conductor/secrets.sh): at boot, then hourly by
# score-secrets.timer. Each is read by name from Scaleway Secret Manager through the secret reader.
[Unit]
Description=SCORE conductor: file-shaped secrets to tmpfs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/score/dashboard.env
ExecStart=/bin/sh %h/projects/score/tools/cloud/conductor/secrets.sh

[Install]
WantedBy=default.target
