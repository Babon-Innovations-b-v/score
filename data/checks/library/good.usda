#usda 1.0
(
    defaultPrim = "fixture"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Known good (score/stages/complete/library/library_test.py): a crate the export marked as a library model, finished in a library surface it names; a code-built wall in the place's library material; a lamp and a sound source the export marked."
)

def Xform "fixture"
{
    def Scope "Library"
    {
        def Material "deck"
        {
            custom string score:recipe = "painted_metal"
            custom string score:token = "deck"
        }
    }

    def Xform "Objects"
    {
        def Xform "crate_1"
        {
            custom string score:kind = "fixture_crate"
            custom string score:model = "crate_1"
            custom string score:library = "model/crate_1@1"

            def Scope "Looks"
            {
                def Material "bare_steel"
                {
                    custom string score:surface = "bare_steel"
                }
            }

            def Mesh "geo" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </fixture/Objects/crate_1/Looks/bare_steel>
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            }

            def Mesh "collision"
            {
                uniform token purpose = "guide"
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            }
        }
    }

    def Scope "Structure"
    {
        def Mesh "wall" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom string score:kind = "structure"
            custom string score:library = "kit/fixture@1"
            rel material:binding = </fixture/Library/deck>
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (0, 3, 0), (0, 0, 3)]
        }
    }

    def Scope "Lights"
    {
        def SphereLight "lamp_1"
        {
            custom string score:library = "light/lamp@1"
        }
    }

    def Scope "Sound"
    {
        def SpatialAudio "hum"
        {
            custom string score:library = "sound/hum@1"
        }
    }
}
